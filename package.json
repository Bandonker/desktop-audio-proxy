{
  "name": "desktop-audio-proxy",
  "version": "1.1.8",
  "description": "Local CORS bridge and WebKit-aware media transport for Tauri and Electron, with source selection, range requests, and standard HLS rewriting.",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.esm.js",
      "require": "./dist/browser.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.esm.js",
      "require": "./dist/server.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.esm.js",
      "require": "./dist/react.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.esm.js",
      "require": "./dist/vue.cjs"
    }
  },
  "scripts": {
    "build:react-demo": "node scripts/build-react-demo.mjs",
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && rollup -c && node scripts/fix-declaration-imports.mjs",
    "dev": "rollup -c -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:demo-smoke": "node scripts/demo-smoke-test.mjs",
    "build:native-smoke": "npm run build && node scripts/build-native-smoke.mjs",
    "build:native:tauri": "npm run build:native-smoke && cargo build --manifest-path test/native/tauri/src-tauri/Cargo.toml",
    "test:native:electron": "npm run build:native-smoke && node scripts/native-smoke-harness.mjs electron",
    "test:native:tauri": "npm run build:native:tauri && node scripts/native-smoke-harness.mjs tauri",
    "test:native": "npm run test:native:electron && npm run test:native:tauri",
    "test:webkit": "npm run build:native-smoke && node scripts/webkit-smoke-test.mjs",
    "test:all": "npm run build && npm test",
    "verify:exports": "node scripts/verify-exports.js && node scripts/verify-hook-export.js && node scripts/verify-vue-export.js && node scripts/test-server-export.js && node scripts/verify-auto-start.js",
    "verify:auto-start": "node scripts/verify-auto-start.js",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify:examples": "node scripts/verify-examples.mjs && tsc -p tsconfig.examples.json",
    "verify:package": "node scripts/verify-package.js",
    "verify:types": "tsc --noEmit --strict --target ES2020 --module NodeNext --moduleResolution NodeNext scripts/verify-public-types.mts",
    "lint": "eslint src --ext .ts && prettier --check src",
    "lint:fix": "eslint src --ext .ts --fix && prettier --write src",
    "prepublishOnly": "npm run build",
    "proxy:start": "node examples/standalone-server.js",
    "example": "npm run build && npm run proxy:start",
    "demo": "npm run build:react-demo && node demo/start-demo.js",
    "demo:cli": "node demo/cli-demo.js",
    "demo:serve": "node demo/serve-demo.js",
    "demo:simple": "npm run build && npm run proxy:start"
  },
  "keywords": [
    "tauri",
    "electron",
    "audio",
    "proxy",
    "cors",
    "streaming",
    "webkit",
    "media",
    "react",
    "vue",
    "hooks",
    "composables",
    "typescript",
    "bandonker",
    "desktop-audio",
    "audio-proxy",
    "cors-bridge",
    "tauri-cors",
    "electron-audio",
    "tauri-audio",
    "electron-cors",
    "desktop-streaming",
    "audio-streaming",
    "video-streaming",
    "hls-streaming",
    "m3u8-playlist",
    "mp4-streaming",
    "cors-workaround",
    "podcast-streaming",
    "radio-streaming",
    "web-audio-api",
    "desktop-media",
    "cross-origin",
    "tauri-streaming",
    "electron-streaming"
  ],
  "author": {
    "name": "Bandonker",
    "url": "https://github.com/bandonker"
  },
  "contributors": [
    "Bandonker"
  ],
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/bandonker"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bandonker/desktop-audio-proxy.git"
  },
  "homepage": "https://github.com/bandonker/desktop-audio-proxy#readme",
  "bugs": {
    "url": "https://github.com/bandonker/desktop-audio-proxy/issues"
  },
  "files": [
    "dist",
    "!dist/__tests__/**",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.d.ts.map",
    "examples",
    "assets",
    "!assets/visualdemo*.PNG",
    "!assets/clidemo*.PNG",
    "!assets/cliproxy1.PNG",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "TAURI_MIGRATION.md"
  ],
  "dependencies": {
    "axios": "^1.18.1",
    "cors": "^2.8.5",
    "express": "^4.22.2"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "vue": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.13",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "electron": "^43.2.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "jest": "^29.0.0",
    "playwright": "^1.62.0",
    "prettier": "^3.6.2",
    "puppeteer": "^24.11.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rollup": "^3.30.0",
    "ts-jest": "^29.4.0",
    "tslib": "^2.0.0",
    "typescript": "^5.0.0",
    "vue": "^3.5.27"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
